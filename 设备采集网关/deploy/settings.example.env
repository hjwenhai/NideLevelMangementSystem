# Copy to /home/level-gateway/config/service.env AFTER verifying the board.
# Bind Web to the maintenance-interface IP; loopback is the safe initial default.
WEB_LISTEN=127.0.0.1:8088
HARDWARE_WRITES=0
ALLOW_CLOCK_SET=0
# UTC RTC path; calibration records persist in data/clock-state.json.
RTC_DEVICE=/dev/rtc0
WATCHDOG=
TLS_CERT=
TLS_KEY=

# SYS1/2/3 indicators; missing driver reports a warning without stopping collection.
LEDS=1

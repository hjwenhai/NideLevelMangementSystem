# Only the software projects are in the source baseline. Customer references and
# document exports at the workspace root are kept outside this repository.
/*
!/.gitignore
!/液位管理上位机软件/
!/设备采集网关/

/液位管理上位机软件/*
!/液位管理上位机软件/.editorconfig
!/液位管理上位机软件/.gitignore
!/液位管理上位机软件/*.md
!/液位管理上位机软件/*.cmd
!/液位管理上位机软件/*.props
!/液位管理上位机软件/*.slnx
!/液位管理上位机软件/global.json
!/液位管理上位机软件/assets/
!/液位管理上位机软件/deployment/
!/液位管理上位机软件/docs/
!/液位管理上位机软件/src/
!/液位管理上位机软件/tests/
!/液位管理上位机软件/tools/
!/液位管理上位机软件/web/

/设备采集网关/*
!/设备采集网关/.gitignore
!/设备采集网关/*.md
!/设备采集网关/go.mod
!/设备采集网关/go.sum
!/设备采集网关/decisions/
!/设备采集网关/deploy/
!/设备采集网关/docs/
!/设备采集网关/protocols/
!/设备采集网关/src/
!/设备采集网关/tests/
!/设备采集网关/tools/

# Generated dependencies, binaries, captured reports and work files.
.build-tools/
.build-cache/
.module-cache/
node_modules/
bin/
obj/
dist/
coverage/
TestResults/
__pycache__/
*.py[cod]
archive/
output/
outputs/
tmp/
data/
*.log
*.tmp
*.trx
*.ndjson
*.exe
*.dll
*.pdb
*.zip
*.tar
*.gz
*.7z
*.msi
/液位管理上位机软件/src/LevelManager.Host/wwwroot/
/液位管理上位机软件/docs/project_memory/history/
/设备采集网关/tests/*.json
/设备采集网关/tests/*.png
/设备采集网关/tests/*.txt

# Runtime databases, identity and signing material (source public trust JSON is retained).
*.db
*.db-*
*.sqlite*
*.authorization/
installation.json
service.lock
private/
vendor-keys/
secrets/
*.pem
*.key
*.pfx
*.p12
*.gwreq
*.gwlic
*.license
.env
.env.*
*.env
!*.example.env
*密码*.txt
*口令*.txt
*credentials*.json

# Keep editable engineering docs and blank product templates in Git.
*.docx
*.pdf
*.xlsx
!/液位管理上位机软件/assets/capacity-templates/*.xlsx
